# Copy this file to .env. Keep the real key only in .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Run: python -m scripts.nebius_check --models
# Copy the exact NVIDIA Nemotron ID returned for YOUR account below.
NEBIUS_MODEL=

# Hosted judging mode only. Leave local for the Windows prototype.
SHAHID_MODE=local
SHAHID_PUBLIC_ORIGIN=
SHAHID_ACCESS_CODE_HASH=
# Absolute path to SQLite on a persistent volume; parent directory must exist.
SHAHID_DB_PATH=
# Explicit opt-in: hosting starts with paid inference disabled.
SHAHID_AI_ENABLED=false
SHAHID_DAILY_LIMIT=20
SHAHID_TOTAL_LIMIT=120
SHAHID_SESSION_LIMIT=5
SHAHID_COOLDOWN_SECONDS=20

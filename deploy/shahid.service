[Unit]
Description=Shahid judging demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shahid
Group=shahid
WorkingDirectory=/opt/shahid
EnvironmentFile=/etc/shahid/demo.env
Environment=SHAHID_MODE=hosted
Environment=SHAHID_DB_PATH=/var/lib/shahid/demo.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/shahid/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8011 --workers 1 --no-proxy-headers --no-access-log --limit-concurrency 32 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
StateDirectory=shahid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shahid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=512M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target

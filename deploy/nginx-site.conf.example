# Create a NEW virtual host after checking the existing server configuration.
# Replace demo.example.com with your actual Shahid subdomain, then arrange TLS
# using the server's existing certificate tooling BEFORE exposing this service.
# This file is an HTTPS server block template, not a full nginx.conf.
server {
    listen 443 ssl;
    server_name demo.example.com;
    ssl_certificate /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;
    client_max_body_size 650k;

    location / {
        proxy_pass http://127.0.0.1:8011;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_read_timeout 110s;
    }
}

# Private server file: /etc/shahid/demo.env, root-owned mode 600.
# Never publish a filled copy or paste secrets into chat/shell history.
SHAHID_MODE=hosted
SHAHID_DB_PATH=/var/lib/shahid/demo.sqlite3
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
SHAHID_PUBLIC_ORIGIN=https://shahid.rihlati.me
SHAHID_ACCESS_CODE_HASH=
# First deploy disabled; enable only after login and quotas are verified.
SHAHID_AI_ENABLED=false
SHAHID_DAILY_LIMIT=20
SHAHID_TOTAL_LIMIT=120
SHAHID_SESSION_LIMIT=5
SHAHID_COOLDOWN_SECONDS=20
